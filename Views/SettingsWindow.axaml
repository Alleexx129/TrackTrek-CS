<Window
    x:Class="TrackTrek.Avalonia.Views.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TrackTrek.Avalonia.ViewModels"
    mc:Ignorable="d"

    Width="620"
    Height="430"
    MinWidth="540"
    MinHeight="410"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Title="TrackTrek Settings">

	<Design.DataContext>
		<vm:SettingsViewModel />
	</Design.DataContext>

	<Grid Margin="16"
          RowDefinitions="Auto,Auto,Auto,*,Auto"
          RowSpacing="12">

		<!-- Header -->
		<Border Grid.Row="0"
                Classes="section"
                Padding="16">

			<Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="14">

				<Border Width="44"
                        Height="44"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="5">

					<TextBlock Text="⚙"
                               FontSize="22"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
				</Border>

				<StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="3">

					<TextBlock Text="Settings"
                               FontSize="22"
                               FontWeight="Bold"/>

					<TextBlock Text="Configure TrackTrek's search and download options."
                               Classes="muted"
                               FontSize="13"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- General settings -->
		<Border Grid.Row="1"
                Classes="section"
                Padding="16">

			<Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,Auto"
                  RowSpacing="14"
                  ColumnSpacing="20">

				<TextBlock Grid.Row="0"
                           Grid.ColumnSpan="2"
                           Text="GENERAL"
                           Foreground="{DynamicResource AccentBrushLight}"
                           FontSize="12"
                           FontWeight="Bold"/>

				<StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Spacing="2">

					<TextBlock Text="Debug mode"
                               FontWeight="SemiBold"/>

					<TextBlock Text="Enable additional diagnostic information."
                               Classes="muted"
                               FontSize="12"/>
				</StackPanel>

				<CheckBox Grid.Row="1"
                          Grid.Column="1"
                          IsChecked="{Binding IsDebug}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"/>

				<StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Spacing="2">

					<TextBlock Text="Maximum results"
                               FontWeight="SemiBold"/>

					<TextBlock Text="Limits how many search results are displayed."
                               Classes="muted"
                               FontSize="12"/>
				</StackPanel>

				<NumericUpDown Grid.Row="2"
                               Grid.Column="1"
                               Classes="retro"
                               Minimum="1"
                               Maximum="200"
                               Increment="1"
                               FormatString="0"
                               Value="{Binding MaxResults}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
			</Grid>
		</Border>

		<!-- Download folder -->
		<Border Grid.Row="2"
                Classes="section"
                Padding="16">

			<Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,Auto"
                  RowSpacing="10"
                  ColumnSpacing="10">

				<TextBlock Grid.Row="0"
                           Grid.ColumnSpan="2"
                           Text="DOWNLOAD LOCATION"
                           Foreground="{DynamicResource AccentBrushLight}"
                           FontSize="12"
                           FontWeight="Bold"/>

				<TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="Choose where downloaded music files will be saved."
                           Classes="muted"
                           FontSize="12"/>

				<TextBox Grid.Row="2"
                         Grid.Column="0"
                         Classes="folderBox"
                         Text="{Binding DownloadFolder}"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         TextWrapping="NoWrap"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

				<Button Grid.Row="2"
                        Grid.Column="1"
                        Classes="retro"
                        Content="Browse..."
                        MinWidth="100"
                        Click="BrowseFolder_Click"/>
			</Grid>
		</Border>

		<!-- Flexible empty space -->
		<Border Grid.Row="3"
                Background="Transparent"/>

		<!-- Footer -->
		<Border Grid.Row="4"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0">

			<Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="10">

				<TextBlock Grid.Column="0"
                           Text="Changes are applied when you press Save."
                           Classes="muted"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="2,0,12,0"/>

				<Button Grid.Column="1"
                        Classes="ghost"
                        Content="Cancel"
                        MinWidth="90"
                        Click="Cancel_Click"/>

				<Button Grid.Column="2"
                        Classes="retro"
                        Content="Save"
                        MinWidth="90"
                        Click="Save_Click"/>
			</Grid>
		</Border>
	</Grid>
</Window>